# Django Production Environment Configuration Example
# Copy this file to .env and configure values for production

DJANGO_SECRET_KEY=replace-with-a-very-long-random-secret-key-at-least-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=kutuphane.skal.k12.tr,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://kutuphane.skal.k12.tr

# Security (SSL / HTTPS)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Database (Neon Postgres; falls back to local SQLite when unset)
DATABASE_URL=postgresql://neondb_owner:your-neon-password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional custom path for local SQLite fallback (defaults to ./db.sqlite3)
# DJANGO_DB_PATH=db.sqlite3
